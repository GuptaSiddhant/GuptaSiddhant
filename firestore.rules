rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public, read-only content rendered by the website.
    // All writes go through the Admin SDK (which bypasses these rules).
    // Anything else (e.g. `users`) is denied by default.
    match /{collection}/{document=**} {
      allow read: if collection in [
        'projects', 'blog', 'career', 'education',
        'testimonies', 'info', 'about', 'index'
      ];
      allow write: if false;
    }
  }
}
