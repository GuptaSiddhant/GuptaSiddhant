{
  "include": [
    "src/routes.ts",
    "react-router.config.ts",
    "vite.config.ts",
    ".react-router/types/**/*",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "coverage",
  ],
  "compilerOptions": {
    "paths": {
      "@gs/*": [
        "./src/features/*"
      ],
      "~/*": [
        "./src/*"
      ]
    },
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "types": ["node", "vite/client"],
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "strict": true,
    "target": "ES2022",
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}