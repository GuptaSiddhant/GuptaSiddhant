{
  "name": "gs-remix",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "clear": "rm -rf build .react-router .vercel/output || true",
    "dev": "react-router dev",
    "dev:emulator": "bash ./scripts/emulator-dev.sh",
    "start": "react-router-serve build/server/*/index.js",
    "storybook": "run-p -clns storybook:dev:css storybook:dev",
    "storybook:build": "pnpm storybook:build:css; storybook build",
    "storybook:build:css": "cross-env NODE_ENV=production tailwindcss -m -o ./.storybook/tailwind.generated.css",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:dev:css": "cross-env NODE_ENV=production tailwindcss -mw -o ./.storybook/tailwind.generated.css",
    "storybook:serve": "npx -y http-server storybook-static -p 6006 --silent",
    "storybook:test": "npx -y wait-on tcp:6006; test-storybook",
    "storybook:test:dev": "test-storybook --watch",
    "storybook:test:coverage": "test-storybook --coverage",
    "storybook:test-dev": "run-p -clns storybook storybook:test",
    "storybook:test-build": "pnpm storybook:build; run-p -clns storybook:serve storybook:test",
    "test": "vp test run --dir src",
    "test:dev": "vp test --dir src",
    "test:coverage": "vp test run --dir src --coverage",
    "test:clear": "rm -rf ./coverage; rm node_modules/.vitest/results.json",
    "vercel:build": "pnpm build",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@google-cloud/logging-min": "^10.3.1",
    "@graphiql/toolkit": "^1.0.1",
    "@reach/menu-button": "^0.18.0",
    "@reach/popover": "^0.18.0",
    "@react-pdf/renderer": "^4.0.0",
    "@upstash/redis": "^1.19.1",
    "blurhash": "^2.0.5",
    "clsx": "^1.2.1",
    "firebase": "^9.15.0",
    "firebase-admin": "^11.2.0",
    "graphiql": "^6.0.1",
    "graphql": "^16.6.0",
    "lru-cache": "^7.14.1",
    "markdown-to-jsx": "^7.1.7",
    "prism-react-renderer": "^1.3.5",
    "react": "^19.2.7",
    "react-blurhash": "^0.3.0",
    "react-dom": "^19.2.7",
    "@remixicon/react": "^4.6.0",
    "schema-dts": "^1.1.0",
    "znv": "0.3.2",
    "zod": "^3.19.1",
    "react-router": "^8.5.3",
    "@react-router/node": "^8.5.3",
    "@react-router/serve": "^8.5.3",
    "isbot": "^5.1.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.18.6",
    "@google-cloud/storage": "^6.9.0",
    "@react-pdf/types": "^2.3.0",
    "@storybook/addon-a11y": "^7.0.5",
    "@storybook/addon-essentials": "^7.0.5",
    "@storybook/addon-interactions": "^7.0.5",
    "@storybook/addon-links": "^7.0.5",
    "@storybook/addons": "^7.0.5",
    "@storybook/blocks": "^7.0.5",
    "@storybook/react": "^7.0.5",
    "@storybook/react-vite": "^7.0.5",
    "@storybook/test-runner": "^0.10.0",
    "@storybook/testing-library": "^0.1.0",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.7",
    "@testing-library/react": "^16.0.0",
    "@total-typescript/ts-reset": "^0.3.7",
    "@types/eslint": "^8.4.10",
    "@types/jsdom": "^20.0.0",
    "@types/node": "^18.0.0",
    "@types/prop-types": "^15",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-istanbul": "5.1.1",
    "axe-playwright": "^1.2.3",
    "cross-env": "^7.0.3",
    "google-auth-library": "^8.7.0",
    "jsdom": "^20.0.2",
    "npm-run-all": "^4.1.5",
    "prop-types": "^15.8.1",
    "storybook": "^7.0.5",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.1.0",
    "vite-plus": "1.8.0",
    "@react-router/dev": "^8.5.3",
    "@react-router/fs-routes": "^8.5.3",
    "@vercel/react-router": "^1.3.7",
    "vite": "^8.3.8",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "@testing-library/dom": "^10.0.0"
  }
}
