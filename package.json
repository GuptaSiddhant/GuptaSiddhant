{
  "name": "gs",
  "private": true,
  "scripts": {
    "build": "vp run -r build",
    "clear": "vp run -r clear",
    "cli:build": "pnpm --filter guptasiddhant build",
    "cli:dev": "pnpm --filter guptasiddhant dev",
    "cli:start": "pnpm --filter guptasiddhant start",
    "db:backup": "node ./scripts/db-backup.js",
    "db:restore": "FIRESTORE_EMULATOR_HOST=\"localhost:8080\" FIREBASE_STORAGE_EMULATOR_HOST=\"localhost:9199\" node ./scripts/db-restore.js",
    "emulator": "npx firebase-tools emulators:start --import=./.firebase-emulator --export-on-exit",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "functions:build": "pnpm --filter gs-functions build",
    "functions:dev": "pnpm --filter gs-functions dev",
    "functions:deploy": "pnpm --filter gs-functions deploy",
    "functions:serve": "pnpm --filter gs-functions serve",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "next:build": "pnpm --filter gs-next build",
    "next:dev": "pnpm --filter gs-next dev",
    "next:start": "pnpm --filter gs-next start",
    "remix:build": "pnpm --filter gs-remix build",
    "remix:dev": "pnpm --filter gs-remix dev",
    "remix:dev:emulator": "pnpm --filter gs-remix dev:emulator",
    "remix:start": "pnpm --filter gs-remix start",
    "remix:test": "pnpm --filter gs-remix test",
    "remix:test:coverage": "pnpm --filter gs-remix test:coverage",
    "test": "vp run -r test",
    "typecheck": "vp run -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.1.0",
    "vite-plus": "1.8.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.9"
}
